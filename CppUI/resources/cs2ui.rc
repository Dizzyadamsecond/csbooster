IDI_CS2BOOSTER ICON "resources\\cs2_icon.ico"
IDI_SMALL ICON "resources\\cs2_small.ico"

IDR_MAIN_MENU MENU
{
    POPUP "&Arquivo"
    {
        POPUP "&Otimizações"
        {
            MENU "&Aplicar Otimizações", 1
            MENU "&Reverter Otimizações", 2
            SEPARATOR
            MENU "Sair", 3
        }
    }
    POPUP "&Configurações"
    {
        MENU "&Configurar", 4
    }
    POPUP "Sobre"
    {
        MENU "&Sobre", 5
    }
}

IDD_ABOUT DIALOGEX 0, 0, 239, 66
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS
CAPTION "Sobre o CS2 Booster"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
{
    DEFPUSHBUTTON "OK", IDOK, 180, 0, 50, 14
}

IDD_CONFIG_DIALOG DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS
CAPTION "Configurações"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
{
    CONTROL "Aplicar otimizações ao iniciar", 1001, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 20, 20, 150, 10
    CONTROL "Minimizar para bandeja", 1002, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 20, 40, 150, 10
    CONTROL "Atualizar a cada (ms)", 1003, EDIT, ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_VSCROLL, 20, 70, 100, 14
    CONTROL "1000", 1004, EDIT, ES_NUMBER | WS_CHILD | WS_VISIBLE, 130, 70, 50, 14
    PUSHBUTTON "OK", IDOK, 180, 160, 50, 14
    PUSHBUTTON "Cancelar", IDCANCEL, 240, 160, 50, 14
}