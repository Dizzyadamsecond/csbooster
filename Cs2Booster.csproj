<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cs2Booster</RootNamespace>
    <AssemblyName>Cs2Booster</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Cs2Booster</AssemblyTitle>
    <Product>Cs2Booster</Product>
    <Version>1.0.0</Version>
    <Description>Otimizador de performance para Counter-Strike 2 e Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cs2BoosterWrapper\Cs2BoosterWrapper.csproj" />
  </ItemGroup>

</Project>
