<!--
  Noir Pro (Black & White Monochromatic) control styles — WPF (UI-Taste Enhanced)
  AUTO-LINKED with design/tokens.json semantics (Brush.* keys come from Tokens.generated.xaml)
  Do not hardcode colors here; use DynamicResource Brush.* / StaticResource Font.* keys.

  Brushes are referenced with DynamicResource on purpose: ThemeManager swaps the
  token dictionary at runtime and every element must repaint without a restart.

  Ported from the web design system (packages/web/src/components/ui):
    button.tsx  -> ButtonPrimary/Secondary/Ghost/Outline/Soft/Danger + sizes
    card.tsx    -> CardBorder/CardElevated/CardOutline
    badge.tsx   -> Badge tones (accent/neutral/success/danger/warning)
    globals.css -> slim scrollbar + focus ring

  UI-Taste Enhancements:
  - Micro-interactions with smooth animations
  - Elevated visual hierarchy with layered shadows
  - Improved focus states for accessibility
  - Modern card system with depth
  - Refined typography scale
  - Consistent spacing rhythm
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ============================ FONTS ============================ -->
  <FontFamily x:Key="Font.Display">Geist, Inter, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Body">Inter, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Geist Mono, Cascadia Mono, Consolas</FontFamily>

  <!-- ============================ SPACING SCALE ============================ -->
  <sys:Double x:Key="Space.1">4</sys:Double>
  <sys:Double x:Key="Space.2">8</sys:Double>
  <sys:Double x:Key="Space.3">12</sys:Double>
  <sys:Double x:Key="Space.4">16</sys:Double>
  <sys:Double x:Key="Space.5">20</sys:Double>
  <sys:Double x:Key="Space.6">24</sys:Double>
  <sys:Double x:Key="Space.8">32</sys:Double>
  <sys:Double x:Key="Space.10">40</sys:Double>
  <sys:Double x:Key="Space.12">48</sys:Double>

  <!-- ============================ RADIUS SCALE ============================ -->
  <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
  <CornerRadius x:Key="Radius.Md">8</CornerRadius>
  <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
  <CornerRadius x:Key="Radius.Xl">16</CornerRadius>
  <CornerRadius x:Key="Radius.Full">9999</CornerRadius>

  <!-- ============================ SHADOW DEPTH ============================ -->
  <DropShadowEffect x:Key="Shadow.Sm" BlurRadius="4" ShadowDepth="1" Opacity="0.08" Color="{DynamicResource Color.Text}" Direction="270"/>
  <DropShadowEffect x:Key="Shadow.Md" BlurRadius="12" ShadowDepth="4" Opacity="0.10" Color="{DynamicResource Color.Text}" Direction="270"/>
  <DropShadowEffect x:Key="Shadow.Lg" BlurRadius="24" ShadowDepth="8" Opacity="0.12" Color="{DynamicResource Color.Text}" Direction="270"/>
  <DropShadowEffect x:Key="Shadow.Primary" BlurRadius="16" ShadowDepth="4" Opacity="0.25" Color="{DynamicResource Color.Primary}" Direction="270"/>

  <!-- ====================== BUTTON — PRIMARY ======================= -->
  <Style TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryForeground}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryActive}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== BUTTON — PRIMARY ======================= -->
  <!-- O estilo implícito de Button já é o primário (fundo Brush.Primary).
       Esta chave nomeada existe para quem quiser referenciá-lo explicitamente,
       assim como ButtonSecondary, ButtonGhost, ButtonOutline, ButtonSoft e
       ButtonDanger. -->
  <Style x:Key="ButtonPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}"/>

  <!-- ====================== BUTTON — SECONDARY ===================== -->
  <Style x:Key="ButtonSecondary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface3}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface4}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================== BUTTON — GHOST ======================== -->
  <Style x:Key="ButtonGhost" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface2}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface3}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= BUTTON — OUTLINE ======================= -->
  <!-- web: bg-transparent text-text border border-line-strong hover:border-primary hover:text-primary-text -->
  <Style x:Key="ButtonOutline" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryOverlay}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========================= BUTTON — SOFT ======================= -->
  <!-- web: bg-primary-soft text-primary-soft-text border border-primary/20 -->
  <Style x:Key="ButtonSoft" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.PrimarySoftText}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryEdge}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryOverlay}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================== BUTTON — DANGER ======================= -->
  <!-- Destructive action: `danger` lives on a different red ramp step than
       `primary`, so a destructive button can never be read as the main CTA. -->
  <Style x:Key="ButtonDanger" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerForeground}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DangerHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DangerHover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= BUTTON — SIZES ======================== -->
  <!-- web: sm = h-8 px-3 text-xs rounded-md | lg = h-12 px-6 text-base rounded-lg -->
  <Style x:Key="ButtonSmall" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="MinHeight" Value="32"/>
  </Style>

  <Style x:Key="ButtonLarge" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="24,13"/>
    <Setter Property="MinHeight" Value="48"/>
  </Style>

  <!-- ===================== SIDEBAR NAV ITEM ======================== -->
  <Style x:Key="NavItem" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="14,10" Margin="0,2">
            <Grid>
              <Rectangle x:Name="Accent" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Primary}" Visibility="Collapsed"/>
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface2}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
              <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.PrimarySoftText}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========================== TEXTBOX ============================ -->
  <Style TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Primary}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}"/>
    <Setter Property="SelectionOpacity" Value="0.3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== CARD (Border style) ===================== -->
  <!-- web default: bg-surface border border-line hover:border-line-strong -->
  <Style x:Key="CardBorder" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================== CARD — ELEVATED (shadow) ================ -->
  <!-- web elevated: bg-surface-2 border border-line-strong shadow-md
       Border has no Template property, so the elevated card is a
       ContentControl. The shadow lives on a sibling border (no text inside it)
       so ClearType text rendering is preserved on the card content itself. -->
  <Style x:Key="CardElevated" TargetType="{x:Type ContentControl}">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContentControl}">
          <Grid>
            <Border x:Name="Shadow" CornerRadius="12" Background="{TemplateBinding Background}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.10" Color="{DynamicResource Color.Mono950}"/>
              </Border.Effect>
            </Border>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== CARD — OUTLINE ======================== -->
  <!-- web outline: bg-transparent border border-line-strong -->
  <Style x:Key="CardOutline" TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorder}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}"/>
  </Style>

  <!-- ======================= SECTION EYEBROW ======================= -->
  <Style x:Key="EyebrowText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <!-- ======================= SECTION TITLE ========================== -->
  <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ======================= CARD TITLE ============================ -->
  <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- ====================== METRIC LABEL =========================== -->
  <Style x:Key="MetricLabel" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- ====================== METRIC VALUE =========================== -->
  <Style x:Key="MetricValue" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
  </Style>

  <!-- ======================= MONO / BODY =========================== -->
  <Style x:Key="MonoText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="MutedText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- ========================== BADGE ============================== -->
  <!-- web accent: bg-primary-soft text-primary-soft-text border-primary/25 -->
  <Style x:Key="Badge" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimaryEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- web neutral: bg-surface-2 text-muted border-line -->
  <Style x:Key="BadgeNeutral" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}"/>
  </Style>

  <!-- web success: bg-success/10 text-success border-success/30 -->
  <Style x:Key="BadgeSuccess" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessOverlay}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessEdge}"/>
  </Style>

  <!-- web danger: bg-danger/10 text-danger border-danger/30 -->
  <Style x:Key="BadgeDanger" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerOverlay}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerEdge}"/>
  </Style>

  <!-- web warning: bg-warning/10 text-error border-warning/30 -->
  <Style x:Key="BadgeWarning" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{DynamicResource Brush.WarningOverlay}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarningEdge}"/>
  </Style>

  <Style x:Key="BadgeText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.PrimarySoftText}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style x:Key="BadgeTextNeutral" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeText}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
  </Style>

  <Style x:Key="BadgeTextSuccess" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeText}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
  </Style>

  <Style x:Key="BadgeTextDanger" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeText}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
  </Style>

  <Style x:Key="BadgeTextWarning" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeText}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
  </Style>

  <!-- Perfil em execucao usa o tom de sucesso; parado usa o tom neutro. -->
  <Style x:Key="ProfileStatusBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeNeutral}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsRunning}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.SuccessOverlay}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessEdge}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ProfileStatusBadgeText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeTextNeutral}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsRunning}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ========================= STATUS BAR ========================== -->
  <Style x:Key="StatusBarText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="MonitoringStateText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource StatusBarText}">
    <Setter Property="Text" Value="MONITORAMENTO: INATIVO"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
        <Setter Property="Text" Value="MONITORAMENTO: ATIVO"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryText}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ========================= DIVIDER ============================= -->
  <Style x:Key="Divider" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Brush.Line}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="0,16,0,16"/>
  </Style>

  <!-- ====================== SLIM SCROLLBAR ======================== -->
  <!-- web: 8px track on the surface color, full-radius thumb on the line-strong color -->
  <Style x:Key="SlimScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="Bar" Background="{DynamicResource Brush.LineStrong}"
                  CornerRadius="4" Margin="2,2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.TextTertiary}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.TextSecondary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SlimScrollThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
