<Application x:Class="Cs2BoosterDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MonoRed design tokens — generated from design/tokens.json (scripts/generate-tokens.mjs) -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.generated.xaml"/>
                <!-- MonoRed control styles -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

