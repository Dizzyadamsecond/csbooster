<Window x:Class="Cs2BoosterDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 Booster — MonoRed"
        Height="720" Width="1180" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Body}"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ HEADER ============================ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{StaticResource Brush.Primary}">
                        <TextBlock Text="CS2"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontWeight="Bold" FontSize="12"
                                   Foreground="{StaticResource Brush.PrimaryForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CS2 BOOSTER"
                                       FontFamily="{StaticResource Font.Display}"
                                       FontWeight="Bold" FontSize="17"
                                       Foreground="{StaticResource Brush.Text}"/>
                            <Border Background="{StaticResource Brush.PrimarySoft}"
                                    CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MONORED"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontWeight="Bold" FontSize="9"
                                           Foreground="{StaticResource Brush.PrimarySoftText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Elo Boost, Coaching &amp; Sub-Tick Optimizer"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                   Foreground="{StaticResource Brush.Muted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Primary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GameStatusText}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ SIDEBAR ============================ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="0,0,1,0"
                Padding="12,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="MENU"
                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                               FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"
                               Margin="14,4,0,10"/>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}"
                                 Content="Dashboard" Tag="dashboard" IsChecked="True"
                                 GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}"
                                 Content="Optimizacao" Tag="optimize"
                                 GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}"
                                 Content="Perfis de Jogo" Tag="profiles"
                                 GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}"
                                 Content="Monitoramento" Tag="monitor"
                                 GroupName="Nav" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="14,0,0,8">
                    <TextBlock Text="v2.0.0 MonoRed"
                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                               Foreground="{StaticResource Brush.Faint}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ CONTENT ============================ -->
        <Grid Grid.Row="1" Grid.Column="1" x:Name="ContentGrid">

            <!-- DASHBOARD -->
            <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto" Padding="0,4">
                <StackPanel Margin="24,20,24,32">
                    <TextBlock Text="DASHBOARD" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                               FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryText}"/>
                    <TextBlock Text="Visão geral do sistema"
                               FontFamily="{StaticResource Font.Display}" FontSize="26"
                               FontWeight="Bold" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>

                    <UniformGrid Columns="4" Margin="0,20,0,0">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="FPS" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding FpsText}" FontFamily="{StaticResource Font.Display}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.PrimaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="PING" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding PingText}" FontFamily="{StaticResource Font.Display}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="CPU" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding CpuUsageText}" FontFamily="{StaticResource Font.Display}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="TEMP. CPU" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding CpuTempText}" FontFamily="{StaticResource Font.Display}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Coletar Amostra" Click="OnCollectSample"/>
                        <Button Content="Analisar Desempenho" Style="{StaticResource ButtonSecondary}"
                                Click="OnAnalyze" Margin="10,0,0,0"/>
                        <Button Content="Aplicar Perfil Ativo" Style="{StaticResource ButtonGhost}"
                                Click="OnApplyProfile" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="ANÁLISE ESTATÍSTICA"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                       FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,32,0">
                                    <TextBlock Text="AMOSTRAS" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                    <TextBlock Text="{Binding SampleCount}" FontSize="18"
                                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,32,0">
                                    <TextBlock Text="FPS MÉDIO" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                    <TextBlock FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}">
                                        <TextBlock.Text>
                                            <Binding Path="StatisticalAnalysis.AverageFps" StringFormat="{}{0:F0}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Margin="0,0,32,0">
                                    <TextBlock Text="PING MÉDIO" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                    <TextBlock FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}">
                                        <TextBlock.Text>
                                            <Binding Path="StatisticalAnalysis.AveragePing" StringFormat="{}{0:F0} ms"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TEMP. MÉDIA" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                    <TextBlock FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}">
                                        <TextBlock.Text>
                                            <Binding Path="StatisticalAnalysis.AverageTemperature" StringFormat="{}{0:F1} °C"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- OPTIMIZATION -->
            <ScrollViewer x:Name="OptimizePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,4">
                <StackPanel Margin="24,20,24,32">
                    <TextBlock Text="OTIMIZAÇÃO" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                               FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryText}"/>
                    <TextBlock Text="Aplicar otimizações do sistema"
                               FontFamily="{StaticResource Font.Display}" FontSize="26"
                               FontWeight="Bold" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>

                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,16,0" Width="130">
                                    <TextBlock Text="SISTEMA FLEXÍVEL" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                    <TextBlock Text="Otimizações ativas" FontSize="15"
                                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Regra Ativa" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                               FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                    <TextBlock Text="{Binding GameProfiles.GetActiveGame().DisplayName}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.PrimaryText}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Aplicação de alterações de prioridade e conexão pode exigir privilégios elevados."
                                       FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                       Foreground="{StaticResource Brush.Muted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Aplicar Perfil Ativo" Style="{StaticResource ButtonPrimary}"
                                Click="OnApplyProfile"/>
                        <Button Content="Iniciar Monitoramento" Style="{StaticResource ButtonSecondary}"
                                Click="OnStartMonitoring"/>
                        <Button Content="Parar Monitoramento" Style="{StaticResource ButtonGhost}"
                                Click="OnStopMonitoring" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Margin="16,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- PROFILES -->
            <ScrollViewer x:Name="ProfilesPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,4">
                <StackPanel Margin="24,20,24,32">
                    <TextBlock Text="PERFIS DE JOGO" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                               FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryText}"/>
                    <TextBlock Text="Perfil do jogo ativo (CS2)"
                               FontFamily="{StaticResource Font.Display}" FontSize="26"
                               FontWeight="Bold" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>

                    <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding GameProfiles.GetActiveGame().DisplayName}"
                                       FontFamily="{StaticResource Font.Display}" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                            <TextBlock Text="{Binding ProcessName}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                       Foreground="{StaticResource Brush.Muted}" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Jogando:" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding IsRunning}" FontSize="10"
                                           Foreground="{StaticResource Brush.PrimaryText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Perfis disponíveis (próximos a aplicar):"
                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                               FontWeight="Bold" Foreground="{StaticResource Brush.Muted}" Margin="0,16,0,0"/>
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontFamily="{StaticResource Font.Display}" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                            <TextBlock Text="{Binding ProcessName}"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                                       Foreground="{StaticResource Brush.Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                   VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IsRunning}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.PrimaryText}"
                                                       FontFamily="{StaticResource Font.Mono}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- MONITOR -->
            <ScrollViewer x:Name="MonitorPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,4">
                <StackPanel Margin="24,20,24,32">
                    <TextBlock Text="MONITORAMENTO" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                               FontWeight="Bold" Foreground="{StaticResource Brush.PrimaryText}"/>
                    <TextBlock Text="Sistema em tempo real"
                               FontFamily="{StaticResource Font.Display}" FontSize="26"
                               FontWeight="Bold" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>

                    <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="FPS" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding FpsText}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.PrimaryText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="PING" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding PingText}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="CPU" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding CpuUsageText}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="TEMP" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding CpuTempText}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="GPU" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="{Binding GpuTempText}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Iniciar Monitoramento" Style="{StaticResource ButtonPrimary}"
                                Click="OnStartMonitoring"/>
                        <Button Content="Parar Monitoramento" Style="{StaticResource ButtonSecondary}"
                                Click="OnStopMonitoring" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

