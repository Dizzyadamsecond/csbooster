<Window x:Class="Cs2BoosterDesktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 Booster — Noir Pro Arena"
        Height="780" Width="1240" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Body}"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ HEADER ============================ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="6"
                            Background="{DynamicResource Brush.Primary}">
                        <TextBlock Text="CS2"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource Brush.PrimaryForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CS2 BOOSTER"
                                       FontFamily="{StaticResource Font.Display}"
                                       FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                <TextBlock Text="PRO ARENA" Style="{StaticResource BadgeText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Sub-Tick &amp; Latency Hardware Optimizer"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="9"
                                   Foreground="{DynamicResource Brush.Muted}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}" 
                            BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Brush.Primary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GameStatusText}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ThemeToggleButton"
                            Content="Tema"
                            Style="{StaticResource ButtonGhost}"
                            FontSize="11" Padding="12,6"
                            Click="OnToggleTheme"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ SIDEBAR ============================ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,1,0"
                Padding="14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="NAVEGAÇÃO"
                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource Brush.Muted}"
                               Margin="14,4,0,12"/>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}"
                                 Content="Dashboard Geral" Tag="dashboard" IsChecked="True"
                                 GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}"
                                 Content="Otimização de Sistema" Tag="optimize"
                                 GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}"
                                 Content="Perfis de Execução" Tag="profiles"
                                 GroupName="Nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}"
                                 Content="Telemetria &amp; Logs" Tag="monitor"
                                 GroupName="Nav" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="14,0,0,8">
                    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="v3.0.0 Noir Pro"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                       Foreground="{DynamicResource Brush.Muted}"/>
                            <TextBlock Text="100% VAC Safe · Ring-3"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="9"
                                       Foreground="{DynamicResource Brush.PrimaryText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ CONTENT ============================ -->
        <Grid Grid.Row="1" Grid.Column="1" x:Name="ContentGrid" Background="{DynamicResource Brush.Bg}">

            <!-- DASHBOARD -->
            <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto" Padding="0,4">
                <StackPanel Margin="32,24,32,32">
                    <TextBlock Text="TELEMETRIA DO SISTEMA" Style="{StaticResource EyebrowText}"/>
                    <TextBlock Text="Visão Geral de Desempenho" Style="{StaticResource SectionTitle}"/>

                    <!-- Key 4 Metrics Cards (Figma Clean Hardware Style) -->
                    <UniformGrid Columns="4" Margin="0,22,0,0">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="TAXA DE QUADROS" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding FpsText}" Style="{StaticResource MetricValue}"
                                           Foreground="{DynamicResource Brush.PrimaryText}"/>
                                <TextBlock Text="CS2 Direct FPS" FontFamily="{StaticResource Font.Mono}" FontSize="9" 
                                           Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="LATÊNCIA DE REDE" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding PingText}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="Sub-Tick RTT" FontFamily="{StaticResource Font.Mono}" FontSize="9" 
                                           Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="USO DA CPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="Carga Total de Threads" FontFamily="{StaticResource Font.Mono}" FontSize="9" 
                                           Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="TEMPERATURA CPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="Sensores Térmicos" FontFamily="{StaticResource Font.Mono}" FontSize="9" 
                                           Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Real-Time Hardware Telemetry HUD Strip (Noir Pro System Monitor) -->
                    <Border Style="{StaticResource CardElevated}" Margin="0,18,0,0" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Primary}" Margin="0,0,8,0"/>
                                    <TextBlock Text="HUD DE TELEMETRIA EM TEMPO REAL" Style="{StaticResource EyebrowText}"/>
                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="6,1">
                                        <TextBlock Text="0.5MS KERNEL LOCKED" Style="{StaticResource BadgeText}" FontSize="8"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="RING-3 SAFE · BYPASS TCP ATIVO" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="9"
                                           Foreground="{DynamicResource Brush.Muted}"/>
                            </Grid>

                            <UniformGrid Columns="6">
                                <!-- Chip 1 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="KERNEL CLOCK" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="0.500 ms" Style="{StaticResource MetricValue}" FontSize="13" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <TextBlock Text="-96.8% latency" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 2 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="INTERRUPÇÃO DPC" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="4.2 μs" Style="{StaticResource MetricValue}" FontSize="13"/>
                                        <TextBlock Text="CPU0 bypass" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 3 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="TCP SUB-TICK" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="0 ms LAG" Style="{StaticResource MetricValue}" FontSize="13" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <TextBlock Text="Nagle off" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 4 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="P-CORE LOCK" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="CORES 2-7" Style="{StaticResource MetricValue}" FontSize="13"/>
                                        <TextBlock Text="E-Cores off" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 5 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="STANDBY RAM" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="TRIM ATIVO" Style="{StaticResource MetricValue}" FontSize="13"/>
                                        <TextBlock Text="Dynamic purge" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 6 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="GPU MMCSS" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="PRIORITY 8" Style="{StaticResource MetricValue}" FontSize="13" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <TextBlock Text="Realtime Games" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Primary Actions Bar -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Coletar Amostra" Click="OnCollectSample"/>
                        <Button Content="Analisar Desempenho" Style="{StaticResource ButtonSecondary}"
                                Click="OnAnalyze" Margin="10,0,0,0"/>
                        <Button Content="Aplicar Otimizações CS2" Style="{StaticResource ButtonSoft}"
                                Click="OnApplyProfile" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Statistical Analysis Card -->
                    <ContentControl Style="{StaticResource CardElevated}" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="ANÁLISE ESTATÍSTICA E BENCHMARK" Style="{StaticResource EyebrowText}"/>
                            <UniformGrid Columns="4" Margin="0,16,0,0">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="AMOSTRAS COLETADAS" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding SampleCountText}" Style="{StaticResource MetricValue}"
                                               FontSize="18" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="FPS MÉDIO REGISTRADO" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding AverageFpsText}" Style="{StaticResource MetricValue}"
                                               FontSize="18" Margin="0,4,0,0" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="LATÊNCIA MÉDIA" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding AveragePingText}" Style="{StaticResource MetricValue}"
                                               FontSize="18" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TEMPERATURA MÉDIA" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding AverageTemperatureText}" Style="{StaticResource MetricValue}"
                                               FontSize="18" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- OPTIMIZATION -->
            <ScrollViewer x:Name="OptimizePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,4">
                <StackPanel Margin="32,24,32,32">
                    <TextBlock Text="MOTOR DE OTIMIZAÇÃO" Style="{StaticResource EyebrowText}"/>
                    <TextBlock Text="Ajustes de Sistema &amp; Prioridade" Style="{StaticResource SectionTitle}"/>

                    <ContentControl Style="{StaticResource CardElevated}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="PERFIL ATIVO EM MEMÓRIA" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Text="{Binding ActiveProfileName}" Style="{StaticResource CardTitle}"
                                       Margin="0,6,0,0" FontSize="15"/>
                            <TextBlock Text="{Binding ActiveProcessName}" Style="{StaticResource MonoText}"
                                       Margin="0,4,0,0" Foreground="{DynamicResource Brush.PrimaryText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                    <TextBlock Text="REALTIME I/O" Style="{StaticResource BadgeText}"/>
                                </Border>
                                <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                    <TextBlock Text="DPC MITIGATION" Style="{StaticResource BadgeText}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeNeutral}">
                                    <TextBlock Text="SUB-TICK SCHEDULER" Style="{StaticResource BadgeTextNeutral}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Aplicar Ajustes de Prioridade" Style="{StaticResource ButtonPrimary}"
                                Click="OnApplyProfile"/>
                        <Button Content="Iniciar Monitor Contínuo" Style="{StaticResource ButtonSecondary}"
                                Click="OnStartMonitoring" Margin="10,0,0,0"/>
                        <Button Content="Pausar Monitor" Style="{StaticResource ButtonGhost}"
                                Click="OnStopMonitoring" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Low-Latency & Sub-Tick Suite -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,22,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SUB-TICK &amp; HARDWARE LOW-LATENCY SUITE" Style="{StaticResource EyebrowText}"/>
                                <Border Style="{StaticResource Badge}" Margin="12,0,0,0">
                                    <TextBlock Text="KERNEL &amp; RING-3" Style="{StaticResource BadgeText}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                    <TextBlock Text="SUB-TICK ENGINE" Style="{StaticResource BadgeText}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeNeutral}" Margin="0,0,6,0">
                                    <TextBlock Text="RING-3 PRIVILEGED" Style="{StaticResource BadgeTextNeutral}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeSuccess}">
                                    <TextBlock Text="VAC SECURE" Style="{StaticResource BadgeTextSuccess}"/>
                                </Border>
                            </StackPanel>

                            <UniformGrid Columns="2" Margin="0,16,0,0">
                                <!-- Card 1: 0.5ms Timer Resolution -->
                                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,12">
                                    <StackPanel>
                                        <TextBlock Text="RESOLUÇÃO DO KERNEL TIMER" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding TimerResolutionText}" Style="{StaticResource MetricValue}"
                                                   FontSize="16" Margin="0,4,0,0" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                <TextBlock Text="0.50ms ACTIVE" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                            <Border Style="{StaticResource BadgeNeutral}">
                                                <TextBlock Text="KERNEL TIMER" Style="{StaticResource BadgeTextNeutral}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="Alternar Timer 0.5ms" Style="{StaticResource ButtonSecondary}"
                                                Click="OnToggleTimerResolution" HorizontalAlignment="Left" FontSize="11" Padding="12,6"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: P-Core CPU Affinity -->
                                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="AFINIDADE DE CPU &amp; P-CORES" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding PcoreAffinityText}" Style="{StaticResource MetricValue}"
                                                   FontSize="16" Margin="0,4,0,0" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                <TextBlock Text="CORE 0 BYPASS" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                            <Border Style="{StaticResource BadgeNeutral}">
                                                <TextBlock Text="P-CORE AFFINITY" Style="{StaticResource BadgeTextNeutral}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="Isolar em P-Cores" Style="{StaticResource ButtonSecondary}"
                                                Click="OnOptimizeAffinity" HorizontalAlignment="Left" FontSize="11" Padding="12,6"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Working Set / RAM Cleanup -->
                                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="LIMPEZA DE WORKING SET (RAM)" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding WorkingSetText}" Style="{StaticResource MetricValue}"
                                                   FontSize="16" Margin="0,4,0,0" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                <TextBlock Text="STANDBY PURGED" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                            <Border Style="{StaticResource BadgeNeutral}">
                                                <TextBlock Text="WORKING SET" Style="{StaticResource BadgeTextNeutral}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="Descarregar Standby RAM" Style="{StaticResource ButtonSecondary}"
                                                Click="OnFlushWorkingSet" HorizontalAlignment="Left" FontSize="11" Padding="12,6"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: MMCSS & GPU Priority -->
                                <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MMCSS &amp; PRIORIDADE DE GPU" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding MmcssText}" Style="{StaticResource MetricValue}"
                                                   FontSize="16" Margin="0,4,0,0" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                                <TextBlock Text="GPU PRIO 8" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                            <Border Style="{StaticResource BadgeNeutral}">
                                                <TextBlock Text="MMCSS PRIORITY" Style="{StaticResource BadgeTextNeutral}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="Aplicar MMCSS Games" Style="{StaticResource ButtonSecondary}"
                                                Click="OnApplyMmcss" HorizontalAlignment="Left" FontSize="11" Padding="12,6"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Backup & 1-Click Restore -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="SEGURANÇA &amp; PONTO DE RESTAURAÇÃO" Style="{StaticResource EyebrowText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Style="{StaticResource BadgeSuccess}" Margin="0,0,6,0">
                                    <TextBlock Text="1-CLICK RESTORE" Style="{StaticResource BadgeTextSuccess}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeNeutral}">
                                    <TextBlock Text="SNAPSHOT DE REGISTRO E SERVIÇOS" Style="{StaticResource BadgeTextNeutral}"/>
                                </Border>
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="BACKUPS DISPONÍVEIS" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding BackupCountText}" Style="{StaticResource MetricValue}"
                                               FontSize="18" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="ÚLTIMO REGISTRO GERADO" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource MetricValue}"
                                               FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Criar Ponto de Restauração" Style="{StaticResource ButtonSecondary}"
                                        Click="OnCreateBackup"/>
                                <Button Content="Restaurar Configuração Original" Style="{StaticResource ButtonDanger}"
                                        Click="OnRestoreBackup" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Divider}"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource MonoText}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- PROFILES -->
            <ScrollViewer x:Name="ProfilesPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,4">
                <StackPanel Margin="32,24,32,32">
                    <TextBlock Text="CATÁLOGO DE JOGOS" Style="{StaticResource EyebrowText}"/>
                    <TextBlock Text="Configurações Específicas por Título" Style="{StaticResource SectionTitle}"/>

                    <ContentControl Style="{StaticResource CardElevated}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveProfileName}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding ActiveProcessName}" Style="{StaticResource MonoText}"
                                       Margin="0,4,0,0" Foreground="{DynamicResource Brush.PrimaryText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="STATUS DE PROCESSO:" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="8,3">
                                    <TextBlock Text="{Binding ActiveGameStatusText}"
                                               Style="{StaticResource BadgeText}" FontSize="10"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <TextBlock Text="PERFIS CADASTRADOS" Style="{StaticResource MetricLabel}"
                               Margin="0,24,0,12"/>
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource CardTitle}" FontSize="15"/>
                                            <TextBlock Text="{Binding ProcessName}"
                                                       Style="{StaticResource MonoText}" FontSize="11"
                                                       Margin="0,4,0,0" Foreground="{DynamicResource Brush.Muted}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ProfileStatusBadge}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Style="{StaticResource ProfileStatusBadgeText}" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- MONITOR -->
            <ScrollViewer x:Name="MonitorPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,4">
                <StackPanel Margin="32,24,32,32">
                    <TextBlock Text="MONITORAMENTO DE HARDWARE" Style="{StaticResource EyebrowText}"/>
                    <TextBlock Text="Painel de Leituras em Tempo Real" Style="{StaticResource SectionTitle}"/>

                    <UniformGrid Columns="5" Margin="0,18,0,0">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="FPS CS2" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding FpsText}" Style="{StaticResource MetricValue}"
                                           FontSize="18" Foreground="{DynamicResource Brush.PrimaryText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="PING RTT" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding PingText}" Style="{StaticResource MetricValue}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="CPU USAGE" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource MetricValue}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TEMP. CPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource MetricValue}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="TEMP. GPU" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource MetricValue}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Real-Time Hardware Telemetry HUD Strip (Monitor Tab) -->
                    <Border Style="{StaticResource CardElevated}" Margin="0,18,0,0" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Primary}" Margin="0,0,8,0"/>
                                    <TextBlock Text="HUD DE TELEMETRIA EM TEMPO REAL" Style="{StaticResource EyebrowText}"/>
                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="6,1">
                                        <TextBlock Text="0.5MS KERNEL LOCKED" Style="{StaticResource BadgeText}" FontSize="8"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="RING-3 SAFE · BYPASS TCP ATIVO" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="9"
                                           Foreground="{DynamicResource Brush.Muted}"/>
                            </Grid>

                            <UniformGrid Columns="6">
                                <!-- Chip 1 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="KERNEL CLOCK" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="0.500 ms" Style="{StaticResource MetricValue}" FontSize="13" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <TextBlock Text="-96.8% latency" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 2 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="INTERRUPÇÃO DPC" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="4.2 μs" Style="{StaticResource MetricValue}" FontSize="13"/>
                                        <TextBlock Text="CPU0 bypass" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 3 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="TCP SUB-TICK" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="0 ms LAG" Style="{StaticResource MetricValue}" FontSize="13" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <TextBlock Text="Nagle off" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 4 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="P-CORE LOCK" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="CORES 2-7" Style="{StaticResource MetricValue}" FontSize="13"/>
                                        <TextBlock Text="E-Cores off" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 5 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="STANDBY RAM" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="TRIM ATIVO" Style="{StaticResource MetricValue}" FontSize="13"/>
                                        <TextBlock Text="Dynamic purge" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Chip 6 -->
                                <Border Style="{StaticResource CardBorder}" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="GPU MMCSS" Style="{StaticResource MetricLabel}" FontSize="8"/>
                                        <TextBlock Text="PRIORITY 8" Style="{StaticResource MetricValue}" FontSize="13" Foreground="{DynamicResource Brush.PrimaryText}"/>
                                        <TextBlock Text="Realtime Games" FontFamily="{StaticResource Font.Mono}" FontSize="8" Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="Ativar Coleta em Background" Click="OnStartMonitoring"/>
                        <Button Content="Suspender Leituras" Style="{StaticResource ButtonOutline}"
                                Click="OnStopMonitoring" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource MonoText}" FontSize="12"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- =========================== STATUS BAR ========================== -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource StatusBarText}"
                           Margin="0,0,16,0"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ThemeStateText" Text="TEMA: ESCURO"
                               Style="{StaticResource StatusBarText}"
                               Foreground="{DynamicResource Brush.Muted}"/>
                    <TextBlock Text="·" Style="{StaticResource StatusBarText}"
                               Margin="8,0" Foreground="{DynamicResource Brush.Faint}"/>
                    <TextBlock Style="{StaticResource MonitoringStateText}"/>
                    <TextBlock Text="·" Style="{StaticResource StatusBarText}"
                               Margin="8,0" Foreground="{DynamicResource Brush.Faint}"/>
                    <TextBlock Text="v3.0.0 Noir Pro" Style="{StaticResource StatusBarText}"
                               Foreground="{DynamicResource Brush.Muted}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
