<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ProgramEntryPoint>Function</ProgramEntryPoint>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cs2BoosterDesktop</RootNamespace>
    <AssemblyName>Cs2BoosterDesktop</AssemblyName>
    <Version>2.0.0</Version>
    <ApplicationHighDpiSupport>true</ApplicationHighDpiSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cs2BoosterCore\Cs2BoosterCore.csproj" />
  </ItemGroup>

</Project>
